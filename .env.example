# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Absolute URL used for OG images, sitemap, email links. Set per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sentry ---
# DSN is OK to ship to the browser (NEXT_PUBLIC_*); auth token is build-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- PostHog (US cloud) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Resend ---
RESEND_API_KEY=
# Defaults to "VOIDCRAFT <onboarding@resend.dev>" if unset. Override once a
# domain is verified.
RESEND_FROM_EMAIL=

# --- Upstash (rate limiting) ---
# Required for /login, /signup, /forgot-password rate limits. Without these,
# rate limiting becomes a no-op (safe in dev).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
